{
  "servers": {
    "ree": {
      "type": "stdio",
      "command": "${workspaceFolder}/ree/.venv/Scripts/python.exe",
      "args": ["-m", "ree_mcp.app"],
      "cwd": "${workspaceFolder}/ree",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/ree/src"
      }
    },
    "omie": {
      "type": "stdio",
      "command": "${workspaceFolder}/omie/.venv/Scripts/python.exe",
      "args": ["-m", "omie_mcp.app"],
      "cwd": "${workspaceFolder}/omie",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/omie/src"
      }
    },
    "esios": {
      "type": "stdio",
      "command": "docker",
      "args": ["run", "--rm", "-i", "-e", "ESIOS_API_KEY", "mcp/esios"],
      "env": {
        "ESIOS_API_KEY": "${env:ESIOS_API_KEY}"
      }
    }
  }
}
