{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-agent-model-system.example/schemas/mcp-glossary-response-v1.json",
  "title": "GlossarySearchResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query", "language", "glossary_version", "candidates", "retrieved_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "query": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2, "maxLength": 8},
    "domain": {"type": ["string", "null"]},
    "glossary_version": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "canonical_label", "definition", "language", "aliases", "match_type", "score", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "canonical_label": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 2, "maxLength": 8},
          "domain": {"type": ["string", "null"]},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "match_type": {"enum": ["exact", "alias", "prefix", "definition"]},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
