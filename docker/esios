FROM python:3.12-slim-trixie
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_NO_DEV=1

WORKDIR /app

COPY pyproject.toml .
COPY README.md .
COPY src/ src/

RUN uv pip install --system . "spacy>=3.8,<3.9" \
    && python -m spacy download es_core_news_sm

ENTRYPOINT ["python", "-m", "esios.app"]
